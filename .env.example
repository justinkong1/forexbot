# SQLite database path (relative to prisma/ folder works as file:./dev.db)
DATABASE_URL="file:./dev.db"

# Site login (single user for v1)
AUTH_USERNAME="admin"
AUTH_PASSWORD="changeme"

# iron-session secret (32+ chars)
SESSION_SECRET="complex_password_at_least_32_characters_long"

# AES-256 key as 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
