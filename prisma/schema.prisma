generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  id                   String   @id @default("default")
  oandaTokenEnc        String?
  oandaAccountId       String?
  oandaEnv             String   @default("practice")
  geminiKeyEnc         String?
  geminiModel          String   @default("gemini-2.5-flash")
  discordWebhookEnc    String?
  riskPercent          Float    @default(1)
  maxUnits             Int      @default(10000)
  minRiskReward        Float    @default(1)
  sizingMode           String   @default("full_balance")
  balanceUtilization   Float    @default(100)
  autoTradeEnabled     Boolean  @default(false)
  autoWatchlist        String   @default("EUR_USD,USD_JPY,GBP_USD")
  autoTimeframe        String   @default("H1")
  autoIntervalMinutes  Int      @default(60)
  autoMinConfidence    Float    @default(0.7)
  maxOpenTrades        Int      @default(1)
  autoMode             String   @default("strategy")
  enabledStrategies    String   @default("ema_cross,rsi_reversion,macd_cross,bb_bounce")
  strategyMinVotes     Int      @default(1)
  atrSlMult            Float    @default(1.5)
  atrTpMult            Float    @default(2.5)
  liveAcknowledged     Boolean  @default(false)
  liveAutoAcknowledged Boolean  @default(false)
  dailyMaxLoss         Float?
  dailyMaxWin          Float?
  weeklyMaxLoss        Float?
  weeklyMaxWin         Float?
  updatedAt            DateTime @updatedAt
}

model TradeJournal {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  source       String
  outcome      String
  instrument   String
  side         String?
  units        Int?
  entryPrice   Float?
  takeProfit   Float?
  stopLoss     Float?
  confidence   Float?
  rationale    String?
  oandaOrderId String?
  oandaTradeId String?
  realizedPl   Float?
  closedAt     DateTime?
  lesson       String?
  timeframe    String?
  skipReason   String?
}
